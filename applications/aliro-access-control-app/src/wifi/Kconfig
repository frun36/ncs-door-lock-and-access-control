DT_CHOSEN_Z_WIFI := zephyr,wifi

menuconfig DOOR_LOCK_WIFI
	bool "Wi-Fi station support"
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_Z_WIFI))
	help
	  Enable Wi-Fi station mode. The device connects to the network
	  whose credentials are stored using the Wi-Fi credentials library.

if DOOR_LOCK_WIFI

module = DOOR_LOCK_WIFI
module-str = door_lock_wifi
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endif # DOOR_LOCK_WIFI
